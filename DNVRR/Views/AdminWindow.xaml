<Window x:Class="DNVRR.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNVRR - Admin" Width="700" Height="750"
        Background="#1e1e1e" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Scan Network -->
        <GroupBox Header="Scan Network" Foreground="#ccc" BorderBrush="#444"
                  Padding="8" Grid.Row="0">
            <StackPanel>
                <DockPanel>
                    <ComboBox x:Name="AdapterCombo" Width="220" DockPanel.Dock="Left"
                              Background="#333" Foreground="White" BorderBrush="#555" />
                    <Button x:Name="BtnScan" Content="Scan"
                            Click="Scan_Click" Style="{StaticResource AccentButton}"
                            Padding="16,4" Margin="4,0,0,0" DockPanel.Dock="Left" />
                    <Button x:Name="BtnStopScan" Content="Stop"
                            Click="StopScan_Click" Style="{StaticResource SidebarButton}"
                            Padding="16,4" Margin="4,0,0,0" DockPanel.Dock="Left"
                            IsEnabled="False" />
                    <TextBlock x:Name="ScanProgress" Foreground="#888" FontSize="11"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </DockPanel>

                <ListView x:Name="ScanResults" MaxHeight="150" Margin="0,8,0,0"
                          Background="#252525" Foreground="White" BorderBrush="#444"
                          Visibility="Collapsed">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="160"
                                            DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="IP" Width="120"
                                            DisplayMemberBinding="{Binding Ip}" />
                            <GridViewColumn Header="Port" Width="45"
                                            DisplayMemberBinding="{Binding Port}" />
                            <GridViewColumn Header="SDK" Width="45"
                                            DisplayMemberBinding="{Binding SdkPortDisplay}" />
                            <GridViewColumn Header="Model" Width="80"
                                            DisplayMemberBinding="{Binding Model}" />
                            <GridViewColumn Header="" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Button Content="Use" Click="UseDevice_Click"
                                                    Padding="8,2" FontSize="11"
                                                    Background="#333" Foreground="#ddd"
                                                    BorderBrush="#555" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AlreadyAdded}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBlock Text="Added" Foreground="#666" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AlreadyAdded}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </GroupBox>

        <!-- Add NVR -->
        <GroupBox Header="Add / Connect NVR" Foreground="#ccc" BorderBrush="#444"
                  Padding="8" Grid.Row="1" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="8" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBox x:Name="TxtNvrIp" Grid.Column="0" Grid.Row="0"
                         Tag="NVR IP Address" Style="{StaticResource DarkTextBox}" />
                <TextBox x:Name="TxtNvrUser" Grid.Column="1" Grid.Row="0"
                         Tag="Username" Text="admin" Style="{StaticResource DarkTextBox}" Margin="4,0,0,0" />
                <TextBox x:Name="TxtNvrPort" Grid.Column="2" Grid.Row="0"
                         Tag="Port" Text="80" Style="{StaticResource DarkTextBox}" Margin="4,0,0,0" />
                <PasswordBox x:Name="TxtNvrPass" Grid.Column="3" Grid.Row="0"
                             Tag="Password" Margin="4,0,0,0"
                             Background="#333" Foreground="White" BorderBrush="#555" />
                <TextBox x:Name="TxtSdkPort" Grid.Column="4" Grid.Row="0"
                         Tag="SDK Port" Text="8000" Style="{StaticResource DarkTextBox}" Margin="4,0,0,0" />

                <Button Grid.Column="5" Grid.Row="0" Content="Connect"
                        Click="Connect_Click" Style="{StaticResource AccentButton}"
                        Margin="8,0,0,0" Padding="16,4" />

                <TextBlock x:Name="StatusText" Grid.Row="2" Grid.ColumnSpan="6"
                           Foreground="#888" FontSize="11" />
            </Grid>
        </GroupBox>

        <!-- NVR List -->
        <ListView x:Name="NvrList" Grid.Row="2" Margin="0,12,0,0"
                  Background="#252525" Foreground="White" BorderBrush="#444">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="White"
                                               VerticalAlignment="Center" />
                                    <Button Content="&#x270E;" Click="NvrRename_Click"
                                            Padding="4,0" Margin="4,0,0,0" FontSize="10"
                                            Background="Transparent" Foreground="#71717a"
                                            BorderThickness="0" Cursor="Hand"
                                            VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="IP" Width="120" DisplayMemberBinding="{Binding Ip}" />
                    <GridViewColumn Header="Port" Width="50" DisplayMemberBinding="{Binding Port}" />
                    <GridViewColumn Header="SDK Port" Width="60" DisplayMemberBinding="{Binding SdkPort}" />
                    <GridViewColumn Header="Cameras" Width="60" DisplayMemberBinding="{Binding Channels}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Cameras -->
        <GroupBox Header="Cameras" Foreground="#ccc" BorderBrush="#444"
                  Padding="8" Grid.Row="3" Margin="0,8,0,0">
            <ListView x:Name="CameraList" Background="#252525" Foreground="White" BorderBrush="#444">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                           Foreground="#aaa" Margin="4,6,0,2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="160"
                                        DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Ch" Width="40"
                                        DisplayMemberBinding="{Binding Channel}" />
                        <GridViewColumn Header="Status" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Connected" />
                                                <Setter Property="Foreground" Value="#4caf50" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Connected}" Value="False">
                                                        <Setter Property="Text" Value="No feed" />
                                                        <Setter Property="Foreground" Value="#666" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Enabled" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled}"
                                              Checked="CameraToggle_Changed"
                                              Unchecked="CameraToggle_Changed" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="PTZ" Width="50">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding PtzEnabled}"
                                              Checked="CameraToggle_Changed"
                                              Unchecked="CameraToggle_Changed" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Refresh Cameras" Click="Refresh_Click"
                    Style="{StaticResource SidebarButton}" Margin="0,0,4,0" />
            <Button Content="Delete Selected" Click="Delete_Click"
                    Style="{StaticResource SidebarButton}" Foreground="#f44" />
        </StackPanel>
    </Grid>
</Window>
