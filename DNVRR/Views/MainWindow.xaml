<Window x:Class="DNVRR.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNVRR" Width="1280" Height="720"
        Background="#0f1115" WindowState="Maximized"
        Closing="Window_Closing"
        PreviewMouseMove="Window_MouseMove" PreviewMouseLeftButtonUp="Window_MouseUp"
        LocationChanged="Window_StateChanged" SizeChanged="Window_StateChanged"
        StateChanged="Window_StateChanged">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar: Views + Cameras -->
        <Border x:Name="LeftSidebar" Grid.Column="0" Width="190" Background="#1a1d23" BorderBrush="#2a2d35" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Views Header -->
                <DockPanel Grid.Row="0" Margin="10,10,10,4">
                    <TextBlock Text="VIEWS" FontSize="11" FontWeight="Bold"
                               Foreground="#71717a" DockPanel.Dock="Left" VerticalAlignment="Center" />
                    <Button Content="+" Click="NewView_Click" DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            Width="22" Height="22" FontSize="14" Padding="0,-2,0,0"
                            Background="Transparent" Foreground="#71717a"
                            BorderBrush="#2a2d35" Cursor="Hand" />
                </DockPanel>

                <!-- Views List -->
                <StackPanel Grid.Row="1">
                    <!-- Saved Views -->
                    <ItemsControl x:Name="ViewsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="7,7,10,7" Cursor="Hand"
                                        MouseLeftButtonDown="ViewItem_Click"
                                        Background="Transparent" BorderThickness="3,0,0,0"
                                        BorderBrush="Transparent">
                                    <DockPanel>
                                        <Button Content="&#x2715;" Click="ViewDelete_Click"
                                                DockPanel.Dock="Right" VerticalAlignment="Center"
                                                Width="18" Height="18" FontSize="10" Padding="0"
                                                Background="Transparent" Foreground="#ef4444"
                                                BorderBrush="Transparent" Cursor="Hand" />
                                        <TextBlock Text="{Binding Name}" Foreground="#e4e4e7" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Divider -->
                <Border Grid.Row="2" Background="#2a2d35" />

                <!-- Cameras Header -->
                <TextBlock Grid.Row="3" Text="CAMERAS" FontSize="11" FontWeight="Bold"
                           Foreground="#71717a" Margin="10,8,10,4" />

                <!-- Cameras List (grouped by NVR) -->
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CamerasList" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Left toggle -->
        <Border Grid.Column="1" Background="#252530" Width="22">
            <Button x:Name="BtnToggleLeft" Content="◀"
                    Click="ToggleLeftSidebar_Click"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="20" Height="50" FontSize="10" Padding="0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#252530" BorderBrush="#2a2d35" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.Foreground>
                    <SolidColorBrush Color="#71717a" />
                </Button.Foreground>
            </Button>
        </Border>

        <!-- Camera Grid -->
        <Border Grid.Column="2" Background="#2a2d35" Padding="1">
            <Grid x:Name="CameraGrid" />
        </Border>

        <!-- Right toggle -->
        <Border Grid.Column="3" Background="#252530" Width="22">
            <Button x:Name="BtnToggleRight" Content="▶"
                    Click="ToggleRightSidebar_Click"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="20" Height="50" FontSize="10" Padding="0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#252530" BorderBrush="#2a2d35" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.Foreground>
                    <SolidColorBrush Color="#71717a" />
                </Button.Foreground>
            </Button>
        </Border>

        <!-- Right Sidebar: PTZ + Controls -->
        <Border Grid.Column="4" Width="220" Background="#1a1d23" Padding="8"
                BorderBrush="#2a2d35" BorderThickness="1,0,0,0"
                x:Name="Sidebar">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Toolbar -->
                    <TextBlock Text="DNVRR" FontSize="18" FontWeight="Bold"
                               Foreground="#3b82f6" Margin="0,0,0,12" />

                    <Button Content="Admin Panel" Click="OpenAdmin_Click"
                            Style="{StaticResource SidebarButton}" Margin="0,0,0,4" />
                    <Button Content="New Window" Click="NewWindow_Click"
                            Style="{StaticResource SidebarButton}" Margin="0,0,0,4" />
                    <Button Content="Close Window" Click="CloseWindow_Click"
                            Style="{StaticResource SidebarButton}" Margin="0,0,0,4"
                            Foreground="#ef4444" />

                    <Separator Background="#2a2d35" Margin="0,8" />

                    <!-- Grid Layout -->
                    <TextBlock Text="LAYOUT" Foreground="#71717a" FontSize="10"
                               FontWeight="Bold" Margin="0,0,0,4" />
                    <WrapPanel>
                        <Button Content="2x2" Tag="2" Click="Layout_Click"
                                Style="{StaticResource LayoutButton}" />
                        <Button Content="3x3" Tag="3" Click="Layout_Click"
                                Style="{StaticResource LayoutButton}" />
                        <Button Content="4x3" Tag="4" Click="Layout_Click"
                                Style="{StaticResource LayoutButton}" />
                        <Button Content="4x4" Tag="16" Click="Layout_Click"
                                Style="{StaticResource LayoutButton}" />
                    </WrapPanel>

                    <!-- Custom grid size -->
                    <TextBlock Text="CUSTOM" Foreground="#71717a" FontSize="10"
                               FontWeight="Bold" Margin="0,8,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cols" Foreground="#71717a" FontSize="11"
                                   VerticalAlignment="Center" Width="30" />
                        <TextBox x:Name="TxtViewCols" Width="36" Text="4" FontSize="11"
                                 Background="#0f1115" Foreground="#e4e4e7" BorderBrush="#2a2d35"
                                 Padding="4,2" TextChanged="ViewSize_Changed" />
                        <TextBlock Text="Rows" Foreground="#71717a" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0" Width="32" />
                        <TextBox x:Name="TxtViewRows" Width="36" Text="3" FontSize="11"
                                 Background="#0f1115" Foreground="#e4e4e7" BorderBrush="#2a2d35"
                                 Padding="4,2" TextChanged="ViewSize_Changed" />
                    </StackPanel>

                    <Separator Background="#2a2d35" Margin="0,8" />

                    <!-- PTZ Controls -->
                    <TextBlock Text="PTZ CONTROL" Foreground="#71717a" FontSize="10"
                               FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock x:Name="PtzCameraName" Foreground="#71717a" FontSize="11"
                               Margin="0,0,0,8" Text="Click a camera to select" />

                    <Grid HorizontalAlignment="Center" Width="150" Height="150">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Content="&#x2196;"
                                Tag="PAN_LEFT_UP" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />
                        <Button Grid.Row="0" Grid.Column="1" Content="&#x25B2;"
                                Tag="TILT_UP" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />
                        <Button Grid.Row="0" Grid.Column="2" Content="&#x2197;"
                                Tag="PAN_RIGHT_UP" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />

                        <Button Grid.Row="1" Grid.Column="0" Content="&#x25C0;"
                                Tag="PAN_LEFT" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />
                        <Button Grid.Row="1" Grid.Column="1" Content="&#x25CF;"
                                Tag="STOP" Style="{StaticResource PtzButton}"
                                Foreground="#ef4444" Click="PtzStop_Click" />
                        <Button Grid.Row="1" Grid.Column="2" Content="&#x25B6;"
                                Tag="PAN_RIGHT" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />

                        <Button Grid.Row="2" Grid.Column="0" Content="&#x2199;"
                                Tag="PAN_LEFT_DOWN" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />
                        <Button Grid.Row="2" Grid.Column="1" Content="&#x25BC;"
                                Tag="TILT_DOWN" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />
                        <Button Grid.Row="2" Grid.Column="2" Content="&#x2198;"
                                Tag="PAN_RIGHT_DOWN" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />
                    </Grid>

                    <!-- Zoom -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,8,0,0">
                        <Button Content="Zoom +" Width="65" Margin="0,0,4,0"
                                Tag="ZOOM_IN" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />
                        <Button Content="Zoom -" Width="65"
                                Tag="ZOOM_OUT" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />
                    </StackPanel>

                    <Separator Background="#2a2d35" Margin="0,12" />

                    <!-- Stream Type -->
                    <TextBlock Text="STREAM" Foreground="#71717a" FontSize="10"
                               FontWeight="Bold" Margin="0,0,0,4" />
                    <ComboBox x:Name="StreamTypeCombo" SelectedIndex="1"
                              SelectionChanged="StreamType_Changed"
                              Background="#333" Foreground="White">
                        <ComboBoxItem Content="Main Stream (High Quality)" Tag="0" />
                        <ComboBoxItem Content="Sub Stream (Low Bandwidth)" Tag="1" />
                    </ComboBox>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
