<Window x:Class="DNVRR.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNVRR" Width="1280" Height="720"
        Background="#1a1a1a" WindowState="Maximized"
        Closing="Window_Closing">
    <Window.InputBindings>
        <KeyBinding Key="F11" Command="{Binding ToggleFullscreenCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitFullscreenCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Camera Grid -->
        <Grid x:Name="CameraGrid" Grid.Column="0" Background="#111" Margin="2" />

        <!-- Right Sidebar: PTZ + Controls -->
        <Border Grid.Column="1" Width="220" Background="#222" Padding="8"
                x:Name="Sidebar">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Toolbar -->
                    <TextBlock Text="DNVRR" FontSize="18" FontWeight="Bold"
                               Foreground="#0af" Margin="0,0,0,12" />

                    <Button Content="Admin Panel" Click="OpenAdmin_Click"
                            Style="{StaticResource SidebarButton}" Margin="0,0,0,4" />
                    <Button Content="New Window" Click="NewWindow_Click"
                            Style="{StaticResource SidebarButton}" Margin="0,0,0,4" />

                    <Separator Background="#444" Margin="0,8" />

                    <!-- Grid Layout -->
                    <TextBlock Text="LAYOUT" Foreground="#888" FontSize="10"
                               FontWeight="Bold" Margin="0,0,0,4" />
                    <WrapPanel>
                        <Button Content="2x2" Tag="2" Click="Layout_Click"
                                Style="{StaticResource LayoutButton}" />
                        <Button Content="3x3" Tag="3" Click="Layout_Click"
                                Style="{StaticResource LayoutButton}" />
                        <Button Content="4x3" Tag="4" Click="Layout_Click"
                                Style="{StaticResource LayoutButton}" />
                        <Button Content="4x4" Tag="16" Click="Layout_Click"
                                Style="{StaticResource LayoutButton}" />
                    </WrapPanel>

                    <Separator Background="#444" Margin="0,8" />

                    <!-- PTZ Controls -->
                    <TextBlock Text="PTZ CONTROL" Foreground="#888" FontSize="10"
                               FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock x:Name="PtzCameraName" Foreground="#aaa" FontSize="11"
                               Margin="0,0,0,8" Text="Click a camera to select" />

                    <Grid HorizontalAlignment="Center" Width="150" Height="150">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Content="&#x2196;"
                                Tag="PAN_LEFT_UP" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />
                        <Button Grid.Row="0" Grid.Column="1" Content="&#x25B2;"
                                Tag="TILT_UP" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />
                        <Button Grid.Row="0" Grid.Column="2" Content="&#x2197;"
                                Tag="PAN_RIGHT_UP" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />

                        <Button Grid.Row="1" Grid.Column="0" Content="&#x25C0;"
                                Tag="PAN_LEFT" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />
                        <Button Grid.Row="1" Grid.Column="1" Content="&#x25CF;"
                                Tag="STOP" Style="{StaticResource PtzButton}"
                                Foreground="#f44" Click="PtzStop_Click" />
                        <Button Grid.Row="1" Grid.Column="2" Content="&#x25B6;"
                                Tag="PAN_RIGHT" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />

                        <Button Grid.Row="2" Grid.Column="0" Content="&#x2199;"
                                Tag="PAN_LEFT_DOWN" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />
                        <Button Grid.Row="2" Grid.Column="1" Content="&#x25BC;"
                                Tag="TILT_DOWN" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />
                        <Button Grid.Row="2" Grid.Column="2" Content="&#x2198;"
                                Tag="PAN_RIGHT_DOWN" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />
                    </Grid>

                    <!-- Zoom -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,8,0,0">
                        <Button Content="Zoom +" Width="65" Margin="0,0,4,0"
                                Tag="ZOOM_IN" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />
                        <Button Content="Zoom -" Width="65"
                                Tag="ZOOM_OUT" Style="{StaticResource PtzButton}"
                                PreviewMouseLeftButtonDown="Ptz_MouseDown"
                                PreviewMouseLeftButtonUp="Ptz_MouseUp" />
                    </StackPanel>

                    <Separator Background="#444" Margin="0,12" />

                    <!-- Stream Type -->
                    <TextBlock Text="STREAM" Foreground="#888" FontSize="10"
                               FontWeight="Bold" Margin="0,0,0,4" />
                    <ComboBox x:Name="StreamTypeCombo" SelectedIndex="1"
                              SelectionChanged="StreamType_Changed"
                              Background="#333" Foreground="White">
                        <ComboBoxItem Content="Main Stream (High Quality)" Tag="0" />
                        <ComboBoxItem Content="Sub Stream (Low Bandwidth)" Tag="1" />
                    </ComboBox>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
