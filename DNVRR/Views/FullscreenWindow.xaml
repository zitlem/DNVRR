<Window x:Class="DNVRR.Views.FullscreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNVRR - Fullscreen" Background="Black"
        WindowStyle="None" WindowState="Normal"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Grid>
        <Border x:Name="VideoBorder" Background="Black" />
        <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                Background="#66000000" Padding="8,4" CornerRadius="0,0,6,0">
            <TextBlock x:Name="CameraLabel" Foreground="White" FontSize="14" />
        </Border>
        <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Right"
                   Foreground="#555" FontSize="11" Margin="8"
                   Text="Press ESC to exit fullscreen" />
    </Grid>
</Window>
